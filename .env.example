# TikTok Bot Configuration
# ========================

# Your TikTok target username (without @)
TIKTOK_TARGET_USERNAME=your_target_username

# Proxy settings (US-based proxies for US views/engagement)
# Format: protocol://user:pass@host:port
PROXY_LIST=socks5://user:pass@us-proxy1:1080,socks5://user:pass@us-proxy2:1080

# Bot behavior settings
MAX_VIEWS_PER_SESSION=50
MAX_LIKES_PER_SESSION=20
MAX_FOLLOWS_PER_SESSION=10
WATCH_TIME_MIN_SECONDS=15
WATCH_TIME_MAX_SECONDS=60

# Delays (in seconds) to appear human-like
MIN_ACTION_DELAY=3
MAX_ACTION_DELAY=10
SESSION_COOLDOWN_MINUTES=30

# Browser settings
HEADLESS=true
CHROME_BINARY_PATH=

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
