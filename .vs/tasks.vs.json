{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "Install All Dependencies",
      "appliesTo": "requirements.txt",
      "type": "command",
      "command": "python",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "contextType": "build"
    },
    {
      "taskLabel": "Run Bot (All - Once)",
      "appliesTo": "main.py",
      "type": "command",
      "command": "python",
      "args": ["main.py", "--once"],
      "contextType": "default"
    },
    {
      "taskLabel": "Run Bot (Interactive Menu)",
      "appliesTo": "main.py",
      "type": "command",
      "command": "python",
      "args": ["main.py"],
      "contextType": "default"
    },
    {
      "taskLabel": "Scrape Fresh US Proxies",
      "appliesTo": "proxy_scraper.py",
      "type": "command",
      "command": "python",
      "args": ["proxy_scraper.py", "--update-env"],
      "contextType": "default"
    },
    {
      "taskLabel": "Build .exe (Windows)",
      "appliesTo": "build_exe.py",
      "type": "command",
      "command": "python",
      "args": ["build_exe.py", "--clean"],
      "contextType": "build"
    },
    {
      "taskLabel": "Verify Setup",
      "appliesTo": "test_setup.py",
      "type": "command",
      "command": "python",
      "args": ["test_setup.py"],
      "contextType": "default"
    },
    {
      "taskLabel": "Format Code (Black)",
      "appliesTo": "*.py",
      "type": "command",
      "command": "python",
      "args": ["-m", "black", "."],
      "contextType": "default"
    },
    {
      "taskLabel": "Sort Imports (isort)",
      "appliesTo": "*.py",
      "type": "command",
      "command": "python",
      "args": ["-m", "isort", "."],
      "contextType": "default"
    },
    {
      "taskLabel": "Lint Code (Flake8)",
      "appliesTo": "*.py",
      "type": "command",
      "command": "python",
      "args": ["-m", "flake8", "--max-line-length=120", "."],
      "contextType": "default"
    },
    {
      "taskLabel": "Lint Code (Pylint)",
      "appliesTo": "*.py",
      "type": "command",
      "command": "python",
      "args": ["-m", "pylint", "main.py", "config.py", "bot/", "browser/", "utils/"],
      "contextType": "default"
    },
    {
      "taskLabel": "Type Check (Mypy)",
      "appliesTo": "*.py",
      "type": "command",
      "command": "python",
      "args": ["-m", "mypy", "--ignore-missing-imports", "."],
      "contextType": "default"
    },
    {
      "taskLabel": "Run Tests (Pytest)",
      "appliesTo": "*.py",
      "type": "command",
      "command": "python",
      "args": ["-m", "pytest", "-v"],
      "contextType": "default"
    }
  ]
}
