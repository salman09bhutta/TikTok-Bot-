<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>B5E4A3E0-3C8D-4F2A-9A1B-7D6E8F9C0A2B</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>TikTok_Bot_Exact.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>TikTok Bot Exact</Name>
    <RootNamespace>TikTokBot</RootNamespace>
    <InterpreterId>Global|PythonCore|3.12</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TikTok_Bot_Exact.py" />
    <Compile Include="main.py" />
    <Compile Include="config.py" />
    <Compile Include="proxy_scraper.py" />
    <Compile Include="build_exe.py" />
    <Compile Include="test_setup.py" />
    <Compile Include="bot\__init__.py" />
    <Compile Include="bot\viewer.py" />
    <Compile Include="bot\engager.py" />
    <Compile Include="bot\follower.py" />
    <Compile Include="bot\stats.py" />
    <Compile Include="browser\__init__.py" />
    <Compile Include="browser\driver.py" />
    <Compile Include="utils\__init__.py" />
    <Compile Include="utils\logger.py" />
    <Compile Include="utils\helpers.py" />
    <Compile Include="utils\display.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="bot\" />
    <Folder Include="browser\" />
    <Folder Include="utils\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include=".env.example" />
    <Content Include=".gitignore" />
    <Content Include="requirements.txt" />
    <Content Include="README.md" />
    <Content Include="us_proxies.txt" />
    <Content Include="tiktok_bot.spec" />
    <Content Include="build_exe.bat" />
    <Content Include="install_windows.bat" />
    <Content Include="start_bot.bat" />
    <Content Include="run.sh" />
    <Content Include="run_bot.sh" />
    <Content Include="install_termux.sh" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
