# AI Content Engine - Configuration
# ====================================

# AI API Keys (optional - works without them using templates)
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# FREE Stock Footage API Keys (get these for free!)
# Pexels: https://www.pexels.com/api/ (sign up → get key instantly)
# Pixabay: https://pixabay.com/api/docs/ (sign up → get key instantly)
PEXELS_API_KEY=your-pexels-key-here
PIXABAY_API_KEY=your-pixabay-key-here

# YouTube API
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_CHANNEL_ID=your-channel-id

# Posting Schedule
POSTS_PER_DAY=3
POST_TIMES=09:00,13:00,18:00
