# ═══════════════════════════════════════════════════════════
# AI Content Engine - Complete Configuration
# Mini Building Construction Niche
# ═══════════════════════════════════════════════════════════

# ═══ FREE API Keys (get these first!) ═══

# Pexels - FREE stock video footage
# Sign up: https://www.pexels.com/api/ (instant, no credit card)
PEXELS_API_KEY=

# Pixabay - FREE stock video + music
# Sign up: https://pixabay.com/api/docs/ (instant, no credit card)
PIXABAY_API_KEY=

# ═══ AI API Keys (optional - works without them) ═══

# Google Gemini - FREE tier (recommended, easiest)
# Get key: https://ai.google.dev/ → "Get API key"
GEMINI_API_KEY=

# OpenAI GPT - Paid ($5 minimum)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ═══ YouTube Upload (optional) ═══

# 1. Go to https://console.cloud.google.com
# 2. Create project → Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 credentials (Desktop App)
# 4. Download JSON → rename to client_secrets.json
# 5. Place client_secrets.json in this folder
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_CHANNEL_ID=

# ═══ TikTok Upload (optional) ═══

# Your TikTok username (for reference)
TIKTOK_USERNAME=xxmr.building

# TikTok login: Run "python main.py" → option [9]
# Cookies are saved automatically after first login

# ═══ Content Settings ═══

# How many videos to post per day
POSTS_PER_DAY=3

# Posting times (UTC) - comma separated
POST_TIMES=09:00,13:00,18:00

# ═══ Video Settings ═══

# Maximum video duration (seconds) - YouTube Shorts limit is 60
VIDEO_MAX_DURATION=55

# Video quality
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
